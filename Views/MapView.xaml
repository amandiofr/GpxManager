<UserControl x:Class="GpxManager.Views.MapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mapsui="clr-namespace:Mapsui.UI.Wpf;assembly=Mapsui.UI.Wpf"
             DataContextChanged="OnDataContextChanged">
    <Grid>
        <mapsui:MapControl x:Name="MapCtrl"
                           MouseMove="OnMapMouseMove"
                           MouseLeave="OnMapMouseLeave"
                           MouseRightButtonDown="OnRightPanDown"
                           MouseRightButtonUp="OnRightPanUp" />

        <!-- Overlay effacement zone (rubber-band) -->
        <Canvas x:Name="EraserCanvas"
                Background="Transparent"
                IsHitTestVisible="{Binding IsEraserMode}"
                Cursor="Cross"
                MouseLeftButtonDown="OnEraserMouseDown"
                MouseMove="OnEraserMouseMove"
                MouseLeftButtonUp="OnEraserMouseUp"
                MouseWheel="OnEraserMouseWheel"
                MouseRightButtonDown="OnRightPanDown"
                MouseRightButtonUp="OnRightPanUp">
            <Rectangle x:Name="SelectionRect" Visibility="Collapsed"
                       Stroke="#DD2222" StrokeThickness="2" StrokeDashArray="5 3"
                       Fill="#22FF0000" />
        </Canvas>

        <!-- Outils — haut gauche -->
        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top"
                    Margin="10,10,0,0" Orientation="Horizontal">

            <StackPanel.Resources>
                <Style x:Key="ToolToggle" TargetType="ToggleButton">
                    <Setter Property="Background"  Value="Transparent"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Setter Property="Padding"     Value="6,2"/>
                    <Setter Property="FontSize"    Value="12"/>
                    <Setter Property="Cursor"      Value="Hand"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="3" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Background" Value="#FFCCCC"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#EEEEEE"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Resources>

            <Border Background="#FFFFFFDD" BorderBrush="#CCCCCC" BorderThickness="1"
                    CornerRadius="4" Padding="4,2" Margin="0,0,6,0">
                <ToggleButton IsChecked="{Binding IsEraserMode}"
                              Style="{StaticResource ToolToggle}"
                              ToolTip="Tracer un rectangle pour supprimer les points GPS à l'intérieur">
                    ▱ Gommer
                </ToggleButton>
            </Border>

            <Border Background="#FFFFFFDD" BorderBrush="#CCCCCC" BorderThickness="1"
                    CornerRadius="4" Padding="4,2" Margin="0,0,6,0">
                <ToggleButton IsChecked="{Binding IsSplitMode}"
                              Style="{StaticResource ToolToggle}"
                              ToolTip="Cliquer sur la carte pour diviser la trace au point le plus proche">
                    ✂ Diviser
                </ToggleButton>
            </Border>

            <Border Background="#FFFFFFDD" BorderBrush="#CCCCCC" BorderThickness="1"
                    CornerRadius="4" Padding="4,2">
                <ToggleButton IsChecked="{Binding IsPeloteMode}"
                              Style="{StaticResource ToolToggle}"
                              ToolTip="Détecter et afficher les pelotes GPS (amas de points erratiques)">
                    🧶 Pelotes
                </ToggleButton>
            </Border>

        </StackPanel>

        <!-- Modes carte + Fit — haut droite -->
        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,10,10,0" Orientation="Horizontal">

            <!-- Toggle Carte / Topo / Satellite -->
            <Border Background="#FFFFFFDD" BorderBrush="#CCCCCC" BorderThickness="1"
                    CornerRadius="4" Padding="6,4" Margin="0,0,6,0">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="Carte" IsChecked="{Binding IsMapMode}"
                                 GroupName="MapSource" VerticalContentAlignment="Center"
                                 Margin="0,0,10,0" FontSize="12" />
                    <RadioButton Content="Topo" IsChecked="{Binding IsTopoMode}"
                                 GroupName="MapSource" VerticalContentAlignment="Center"
                                 Margin="0,0,10,0" FontSize="12" />
                    <RadioButton Content="Satellite" IsChecked="{Binding IsSatelliteMode}"
                                 GroupName="MapSource" VerticalContentAlignment="Center"
                                 FontSize="12" />
                </StackPanel>
            </Border>

            <!-- Bouton Fit -->
            <Border Background="#FFFFFFDD" BorderBrush="#CCCCCC" BorderThickness="1"
                    CornerRadius="4" Padding="2">
                <Button Content="⛶" FontSize="16" Width="28" Height="28"
                        Background="Transparent" BorderThickness="0"
                        Click="OnFitClick" ToolTip="Recentrer sur la trace"
                        Cursor="Hand" />
            </Border>
        </StackPanel>

        <!-- Tooltip waypoint + indicateur split -->
        <Canvas IsHitTestVisible="False">
            <Ellipse x:Name="SplitPreviewDot" Visibility="Collapsed"
                     Width="14" Height="14"
                     Fill="#DD2222" Stroke="White" StrokeThickness="2.5"/>
            <Border x:Name="WaypointTooltip" Visibility="Collapsed"
                    Background="White" BorderBrush="#BBBBBB" BorderThickness="1"
                    Padding="9,7" CornerRadius="3" MaxWidth="240">
                <StackPanel>
                    <TextBlock x:Name="WptName" FontWeight="SemiBold" FontSize="12"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="WptElevation" FontSize="11" Foreground="#555555"
                               Margin="0,3,0,0" />
                    <TextBlock x:Name="WptDescription" FontSize="11" Foreground="#444444"
                               Margin="0,2,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Canvas>
    </Grid>
</UserControl>
