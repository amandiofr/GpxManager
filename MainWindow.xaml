<Window x:Class="GpxManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:GpxManager.ViewModels"
        xmlns:views="clr-namespace:GpxManager.Views"
        Title="GPX Manager"
        Icon="/Assets/app.ico"
        Height="620" Width="960"
        MinHeight="400" MinWidth="640"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        DragOver="OnWindowDragOver"
        Drop="OnWindowDrop"
        Closing="OnWindowClosing">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Ctrl" Command="{Binding OpenFileCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#888888" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,10,0,2" />
        </Style>
        <Style x:Key="ValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,10,0,2" />
        </Style>
        <Style x:Key="StatLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#888888" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="StatValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style x:Key="TabCloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,1" />
            <Setter Property="Margin" Value="7,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#999999" />
            <Setter Property="FontSize" Value="10" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#CC2222" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel>
        <ToolBarTray DockPanel.Dock="Top" IsLocked="True">
            <ToolBar>
                <Button Command="{Binding OpenFileCommand}" Padding="10,5" FontSize="13"
                        ToolTip="Ouvrir un ou plusieurs fichiers GPX (Ctrl+O)">
                    📂  Ouvrir GPX
                </Button>
                <Button Command="{Binding SelectedTab.SaveCommand}" Padding="10,5" FontSize="13"
                        Visibility="{Binding SelectedTab.IsDirty, Converter={StaticResource BoolToVis}}"
                        ToolTip="Enregistrer les modifications dans le fichier GPX">
                    💾  Enregistrer
                </Button>
            </ToolBar>
        </ToolBarTray>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="#555555" />
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <!-- État vide -->
            <TextBlock Text="Ouvrez un fichier GPX pour commencer  (📂 ou Ctrl+O)"
                       Foreground="#CCCCCC" FontSize="16"
                       HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasTabs}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Onglets fichiers GPX -->
            <TabControl ItemsSource="{Binding Tabs}"
                        SelectedItem="{Binding SelectedTab}">
                <TabControl.Style>
                    <Style TargetType="TabControl">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasTabs}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TabControl.Style>

                <TabControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding TabTitle}" VerticalAlignment="Center"
                                       MaxWidth="200" TextTrimming="CharacterEllipsis" />
                            <Button Command="{Binding CloseCommand}"
                                    Style="{StaticResource TabCloseButtonStyle}"
                                    Content="✕" ToolTip="Fermer" />
                        </StackPanel>
                    </DataTemplate>
                </TabControl.ItemTemplate>

                <TabControl.ContentTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="240" MinWidth="140" />
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Panneau gauche : liste des traces + détails -->
                            <DockPanel Grid.Column="0" Background="#F4F4F4">
                                <Border DockPanel.Dock="Top" Background="#E0E0E0" Padding="10,5,6,5">
                                    <DockPanel>
                                        <TextBlock Text="TRACES" FontWeight="Bold" FontSize="11"
                                                   Foreground="#555555" VerticalAlignment="Center" />
                                        <Button DockPanel.Dock="Right" Content="✂ Épurer"
                                                Command="{Binding EpurerCommand}"
                                                Padding="7,2" FontSize="11"
                                                HorizontalAlignment="Right"
                                                Visibility="{Binding HasStrippableTags, Converter={StaticResource BoolToVis}}"
                                                ToolTip="Supprimer les balises extensions, geotracker et metadata" />
                                    </DockPanel>
                                </Border>

                                <!-- Détails de la trace sélectionnée -->
                                <Border DockPanel.Dock="Bottom" Background="#EBEBEB" Padding="10,10,10,10">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedTrack}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel DataContext="{Binding SelectedTrack}">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12"
                                                   TextTrimming="CharacterEllipsis" Margin="0,0,0,8" />
                                        <UniformGrid Columns="2" Margin="0,0,0,8">
                                            <StackPanel Margin="0,0,6,6">
                                                <TextBlock Text="DISTANCE" Foreground="#888" FontSize="10" Margin="0,0,0,2" />
                                                <TextBlock Text="{Binding Distance}" FontSize="15" FontWeight="Bold" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,0,6">
                                                <TextBlock Text="DURÉE" Foreground="#888" FontSize="10" Margin="0,0,0,2" />
                                                <TextBlock Text="{Binding Duration}" FontSize="15" FontWeight="Bold" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,6,6">
                                                <TextBlock Text="D +" Foreground="#888" FontSize="10" Margin="0,0,0,2" />
                                                <TextBlock Text="{Binding ElevationGain}" FontSize="15" FontWeight="Bold" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,0,6">
                                                <TextBlock Text="D −" Foreground="#888" FontSize="10" Margin="0,0,0,2" />
                                                <TextBlock Text="{Binding ElevationLoss}" FontSize="15" FontWeight="Bold" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,6,0">
                                                <TextBlock Text="ALT. MIN" Foreground="#888" FontSize="10" Margin="0,0,0,2" />
                                                <TextBlock Text="{Binding ElevationMin}" FontSize="15" FontWeight="Bold" />
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="ALT. MAX" Foreground="#888" FontSize="10" Margin="0,0,0,2" />
                                                <TextBlock Text="{Binding ElevationMax}" FontSize="15" FontWeight="Bold" />
                                            </StackPanel>
                                        </UniformGrid>
                                        <Separator Margin="0,0,0,8" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Départ"    Foreground="#888" FontSize="10" Margin="0,0,8,4" />
                                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding StartTime}" FontSize="11" FontWeight="SemiBold" />
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Arrivée"   Foreground="#888" FontSize="10" Margin="0,0,8,4" />
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding EndTime}"   FontSize="11" FontWeight="SemiBold" />
                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Points GPS" Foreground="#888" FontSize="10" Margin="0,0,8,0" />
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding PointCount}" FontSize="11" FontWeight="SemiBold" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <ListBox ItemsSource="{Binding Tracks}"
                                         SelectionMode="Extended"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         AllowDrop="True"
                                         PreviewMouseLeftButtonDown="OnTrackListMouseDown"
                                         PreviewMouseLeftButtonUp="OnTrackListMouseUp"
                                         PreviewMouseMove="OnTrackListPreviewMouseMove"
                                         DragOver="OnTrackListDragOver"
                                         DragLeave="OnTrackListDragLeave"
                                         Drop="OnTrackListDrop"
                                         SelectionChanged="OnTrackListSelectionChanged"
                                         Loaded="OnTrackListLoaded">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="4,5"
                                                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}">
                                                <StackPanel.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="Renommer"
                                                                  Command="{Binding PlacementTarget.Tag.RenameTrackCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                        <MenuItem Header="Copier"
                                                                  Command="{Binding PlacementTarget.Tag.CopyTracksCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                        <MenuItem Header="Coller"
                                                                  Command="{Binding PlacementTarget.Tag.PasteTracksCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                        <Separator />
                                                        <MenuItem Header="Joindre les 2 traces sélectionnées"
                                                                  Command="{Binding PlacementTarget.Tag.JoinTracksCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                        <Separator />
                                                        <MenuItem Header="Supprimer"
                                                                  Command="{Binding PlacementTarget.Tag.DeleteTrackCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                    </ContextMenu>
                                                </StackPanel.ContextMenu>
                                                <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding Number, Mode=OneWay}" /><Run Text=".  " /><Run Text="{Binding Name, Mode=OneWay}" />
                                                </TextBlock>
                                                <TextBlock FontSize="11" Foreground="#777777">
                                                    <Run Text="{Binding Distance, Mode=OneWay}" />
                                                    <Run Text=" · " />
                                                    <Run Text="{Binding PointCount, Mode=OneWay}" />
                                                    <Run Text=" pts" />
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>

                            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#CCCCCC" />

                            <!-- Panneau droit : Carte -->
                            <views:MapView Grid.Column="2" />
                        </Grid>
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
